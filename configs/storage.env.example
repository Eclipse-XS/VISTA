# Storage configuration template (copy to configs/storage.env for local use).
# OAuth credentials and tokens stay in ~/.config/rclone/rclone.conf and are NEVER committed.
#
# --- Option A: Google Drive (current durable dataset storage) ---
# All operations are confined inside the single root folder `VISTA MVTEC3D`.
# NOTE: Path validation and `--drive-root-folder-id` are operational safeguards,
# NOT Google OAuth permission boundaries.
STORAGE_BACKEND=gdrive
STORAGE_REMOTE=gdrive
STORAGE_ROOT="VISTA MVTEC3D"
STORAGE_ROOT_FOLDER_ID=<resolve-folder-id-of-VISTA-MVTEC3D>
LOCAL_CACHE_DIR=data/cache
MVTEC_CACHE_DIR=data/cache/mvtec_3d_ad
LOCAL_DATA_DIR=data

# Optional: if running Python on Windows while rclone lives in WSL2 Ubuntu-24.04
RCLONE_WSL_DISTRO=Ubuntu-24.04
# Force IPv4 if WSL2 IPv6 stalls Google API requests
RCLONE_BIND=0.0.0.0
RCLONE_TRANSFERS=4
RCLONE_CHECKERS=8

# --- Option B: AWS S3 (future migration — zero pipeline code changes) ---
# 1. Configure an rclone remote named "s3" (type=s3, provider=AWS, env_auth=true or IAM role)
# 2. Switch the settings below (and leave STORAGE_ROOT_FOLDER_ID empty):
# STORAGE_BACKEND=s3
# STORAGE_REMOTE=s3
# STORAGE_ROOT=your-vista-bucket/vista-mvtec3d
# STORAGE_ROOT_FOLDER_ID=
# RCLONE_WSL_DISTRO=
