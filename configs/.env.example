# Copy to .env in the repository root for local development (NEVER commit .env).

VISTA_PG_HOST=127.0.0.1
VISTA_PG_PORT=5435
VISTA_PG_DB=vista_metadata
VISTA_PG_USER=vista
VISTA_PG_PASSWORD=vista_local_dev

# Optional MLflow tracking URI (local SQLite store by default; or http://127.0.0.1:5050 with compose profile)
VISTA_MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
VISTA_MLFLOW_EXPERIMENT=vista-data-engineering

# Prefect local ephemeral mode (no external server required)
PREFECT_LOGGING_LEVEL=INFO
