# Copy to .env in the repository root for local development (NEVER commit .env).

VISTA_PG_HOST=127.0.0.1
VISTA_PG_PORT=5435
VISTA_PG_DB=vista_metadata
VISTA_PG_USER=vista
VISTA_PG_PASSWORD=vista_local_dev

# Canonical MLflow tracking configuration (local SQLite and optional container server share ./mlruns/mlflow.db)
# Modes:
#   local    -> resolves to sqlite:///mlruns/mlflow.db (default; blocked automatically if container server is active)
#   server   -> resolves to http://127.0.0.1:${VISTA_MLFLOW_PORT} (requires `docker compose --profile mlflow up -d`)
#   disabled -> disables MLflow logging completely
VISTA_MLFLOW_MODE=local
# Optional override. Leave commented so VISTA_MLFLOW_MODE deterministically selects the URI.
# Must be compatible with VISTA_MLFLOW_MODE (http(s):// for server, sqlite:/// or file:// for local).
# VISTA_MLFLOW_TRACKING_URI=
VISTA_MLFLOW_EXPERIMENT=vista-data-engineering
# Failure policy when MLflow is unreachable or writer-guarded: warn (non-blocking) | strict
VISTA_MLFLOW_FAILURE_POLICY=warn
VISTA_MLFLOW_PORT=5050
# Optional container image tag (defaults to v3.18.0 for client/server & SQLite schema parity)
# VISTA_MLFLOW_IMAGE_TAG=v3.18.0

# Prefect local ephemeral execution (Model A: PostgreSQL is the authoritative operational state store)
PREFECT_LOGGING_LEVEL=INFO
