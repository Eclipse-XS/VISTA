# Secrets, credentials, and local environment files (NEVER commit)
.env
.env.*
!.env.example
configs/*.env
!configs/*.env.example
rclone.conf
*.conf.bak
*client_secret*.json
*credentials*.json
*service_account*.json
*.token
*.pem
*.key
*.p12
*.pfx

# Datasets, archives, local caches, and large generated artifacts
data/cache/*
!data/cache/.gitkeep
!data/cache/mvtec_3d_ad/
data/cache/mvtec_3d_ad/*
!data/cache/mvtec_3d_ad/.gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/bronze/
data/silver/
data/gold/
data/quarantine/
data/warehouse/
*.tar.xz
*.tar.gz
*.zip
*.tiff
*.tif
*.npy
*.npz
*.parquet
*.ply
*.pcd

